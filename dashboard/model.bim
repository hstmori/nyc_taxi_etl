            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\mart_daily.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"source_month\", \"pickup_date\", \"trip_count\", \"recorded_total_amount\", \"avg_recorded_amount\", \"median_distance_miles\", \"median_duration_minutes\", \"flagged_trip_count\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"source_month\", type text}, {\"pickup_date\", type date}, {\"trip_count\", Int64.Type}, {\"recorded_total_amount\", type number}, {\"avg_recorded_amount\", type number}, {\"median_distance_miles\", type number}, {\"median_duration_minutes\", type number}, {\"flagged_trip_count\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ],
