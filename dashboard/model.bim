        "measures": [
          {
            "name": "Giá trị thiếu",
            "description": "Per-column count only; grand total across columns intentionally blank.",
            "expression": "IF(ISINSCOPE(Missing[column_name]), SUM(Missing[missing_count]))",
            "formatString": "#,0",
            "displayFolder": "Dashboard",
            "lineageTag": "7ccd2b92-2e32-4835-95ac-9a1bc091f51d",
