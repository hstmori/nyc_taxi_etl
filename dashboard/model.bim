          },
          {
            "name": "Tỷ lệ thiếu",
            "description": "Weighted by source rows within the selected months; no total across columns.",
            "expression": "IF(ISINSCOPE(Missing[column_name]), DIVIDE(SUM(Missing[missing_count]),SUM(Missing[raw_rows])))",
            "formatString": "0.00%",
            "displayFolder": "Dashboard",
