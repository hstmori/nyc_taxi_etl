          {
            "type": "calculated",
            "name": "Thứ",
            "dataType": "string",
            "expression": "SWITCH(Hourly[iso_weekday],1,\"Thứ 2\",2,\"Thứ 3\",3,\"Thứ 4\",4,\"Thứ 5\",5,\"Thứ 6\",6,\"Thứ 7\",7,\"Chủ nhật\")",
            "sortByColumn": "iso_weekday",
            "lineageTag": "3aef39f8-c2d6-43ae-a589-9462725b5f15",
            "modifiedTime": "2026-11-02T09:06:24.586667",
            "structureModifiedTime": "2026-11-02T09:06:21.976667",
            "refreshedTime": "2026-11-02T09:06:24.586667",
            "attributeHierarchy": {
              "state": "ready",
              "modifiedTime": "2026-11-02T09:06:24.586667",
              "refreshedTime": "2026-11-02T09:06:24.586667"
            }
          }
        ],
        "partitions": [
          {
            "name": "Hourly",
            "mode": "import",
            "state": "ready",
            "modifiedTime": "2026-11-01T07:55:23.493333",
            "refreshedTime": "2026-11-01T07:55:23.493333",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\mart_hourly.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"source_month\", \"iso_weekday\", \"pickup_hour\", \"trip_count\", \"recorded_total_amount\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"source_month\", type text}, {\"iso_weekday\", Int64.Type}, {\"pickup_hour\", Int64.Type}, {\"trip_count\", Int64.Type}, {\"recorded_total_amount\", type number}}, \"en-US\")\nin\n    Typed"
            }
          }
        ],
        "measures": [
          {
            "name": "Chuyến theo giờ",
            "expression": "SUM(Hourly[trip_count])",
            "formatString": "#,0",
            "displayFolder": "Dashboard",
            "lineageTag": "f335147e-e7ea-4abe-b90c-629d7e2f4cb5",
            "dataType": "int64",
            "modifiedTime": "2026-11-01T07:55:06.643333",
            "structureModifiedTime": "2026-11-01T07:55:01.876667"
          },
          {
            "name": "Tiền theo giờ",
            "expression": "SUM(Hourly[recorded_total_amount])",
            "formatString": "$#,0.00",
            "displayFolder": "Phân tích chuyên sâu",
            "lineageTag": "1b73f3f4-a17a-4049-9a74-7aaa81a96a1a",
            "dataType": "double",
            "modifiedTime": "2026-11-02T09:06:22.08",
            "structureModifiedTime": "2026-11-02T09:06:21.976667"
          },
          {
            "name": "Tiền / chuyến theo giờ",
            "expression": "DIVIDE([Tiền theo giờ],[Chuyến theo giờ])",
            "formatString": "$0.00",
            "displayFolder": "Phân tích chuyên sâu",
            "lineageTag": "e4e300a5-6240-4e5a-b2a7-ef0d71578005",
            "dataType": "double",
            "modifiedTime": "2026-11-02T09:06:22.08",
            "structureModifiedTime": "2026-11-02T09:06:21.976667"
          },
          {
            "name": "Số ngày cùng thứ",
            "expression": "VAR DaysSelected = VALUES(Hourly[iso_weekday]) RETURN COUNTROWS(FILTER(Daily, WEEKDAY(Daily[pickup_date],2) IN DaysSelected))",
            "formatString": "#,0",
            "displayFolder": "Phân tích chuyên sâu",
            "lineageTag": "ab2451ae-305d-4381-8917-8ec5304bc055",
            "dataType": "int64",
            "modifiedTime": "2026-11-02T09:06:22.08",
            "structureModifiedTime": "2026-11-02T09:06:21.976667"
          },
          {
            "name": "Chuyến / ngày theo thời điểm",
            "expression": "DIVIDE([Chuyến theo giờ],[Số ngày cùng thứ])",
            "formatString": "#,0",
            "displayFolder": "Phân tích chuyên sâu",
            "lineageTag": "748ae537-c35e-4b07-b8b2-23ef81d4d534",
            "dataType": "double",
            "modifiedTime": "2026-11-02T09:06:22.08",
            "structureModifiedTime": "2026-11-02T09:06:21.976667"
          },
          {
            "name": "Tỷ trọng chuyến cuối tuần",
            "expression": "DIVIDE(CALCULATE([Chuyến theo giờ], REMOVEFILTERS(Hourly[pickup_hour],Hourly[Thứ],Hourly[iso_weekday]),Hourly[iso_weekday] IN {6,7}),CALCULATE([Chuyến theo giờ],REMOVEFILTERS(Hourly[pickup_hour],Hourly[Thứ],Hourly[iso_weekday])))",
            "formatString": "0.0%",
            "displayFolder": "Phân tích chuyên sâu",
            "lineageTag": "e661107d-43ed-4948-8371-0b7ac8a735a4",
            "dataType": "double",
            "modifiedTime": "2026-11-02T09:06:22.08",
            "structureModifiedTime": "2026-11-02T09:06:21.976667"
          }
        ]
      },
