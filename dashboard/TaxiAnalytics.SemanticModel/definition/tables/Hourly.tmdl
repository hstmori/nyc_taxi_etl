/// ETL export: mart_hourly.csv. Grain and caveats: docs/power-bi.md.
table Hourly
	lineageTag: e236e210-bc31-49d4-b0cf-0540269bfc05

	measure 'Chuyến theo giờ' = SUM(Hourly[trip_count])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: f335147e-e7ea-4abe-b90c-629d7e2f4cb5

	measure 'Tiền theo giờ' = SUM(Hourly[recorded_total_amount])
		formatString: $#,0.00
		displayFolder: Phân tích chuyên sâu
		lineageTag: 1b73f3f4-a17a-4049-9a74-7aaa81a96a1a

	measure 'Tiền / chuyến theo giờ' = DIVIDE([Tiền theo giờ],[Chuyến theo giờ])
		formatString: $0.00
		displayFolder: Phân tích chuyên sâu
		lineageTag: e4e300a5-6240-4e5a-b2a7-ef0d71578005

	measure 'Số ngày cùng thứ' = VAR DaysSelected = VALUES(Hourly[iso_weekday]) RETURN COUNTROWS(FILTER(Daily, WEEKDAY(Daily[pickup_date],2) IN DaysSelected))
		formatString: #,0
		displayFolder: Phân tích chuyên sâu
		lineageTag: ab2451ae-305d-4381-8917-8ec5304bc055

	measure 'Chuyến / ngày theo thời điểm' = DIVIDE([Chuyến theo giờ],[Số ngày cùng thứ])
		formatString: #,0
		displayFolder: Phân tích chuyên sâu
		lineageTag: 748ae537-c35e-4b07-b8b2-23ef81d4d534

	measure 'Tỷ trọng chuyến cuối tuần' = DIVIDE(CALCULATE([Chuyến theo giờ], REMOVEFILTERS(Hourly[pickup_hour],Hourly[Thứ],Hourly[iso_weekday]),Hourly[iso_weekday] IN {6,7}),CALCULATE([Chuyến theo giờ],REMOVEFILTERS(Hourly[pickup_hour],Hourly[Thứ],Hourly[iso_weekday])))
		formatString: 0.0%
		displayFolder: Phân tích chuyên sâu
		lineageTag: e661107d-43ed-4948-8371-0b7ac8a735a4

	column source_month
		dataType: string
		lineageTag: 6564be49-3983-452e-afdc-f4bef119b7c8
		summarizeBy: none
		sourceColumn: source_month

	column iso_weekday
		dataType: int64
		isHidden
		lineageTag: 91ad6c7a-d791-4965-9311-9f9335ef113b
		summarizeBy: none
		sourceColumn: iso_weekday

	column pickup_hour
		dataType: int64
		lineageTag: 3d6dc77d-3988-4cac-824c-7f61450d8473
		summarizeBy: none
		sourceColumn: pickup_hour

	column trip_count
		dataType: int64
		isHidden
		lineageTag: ca723afa-3a1e-4094-bcb9-363bbefe700f
		summarizeBy: none
		sourceColumn: trip_count

	column recorded_total_amount
		dataType: double
		isHidden
		lineageTag: ee01217e-fddd-427f-bc2d-5762049fbc66
		summarizeBy: none
		sourceColumn: recorded_total_amount

	column Thứ = SWITCH(Hourly[iso_weekday],1,"Thứ 2",2,"Thứ 3",3,"Thứ 4",4,"Thứ 5",5,"Thứ 6",6,"Thứ 7",7,"Chủ nhật")
		dataType: string
		lineageTag: 3aef39f8-c2d6-43ae-a589-9462725b5f15
		sortByColumn: iso_weekday

	partition Hourly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "\mart_hourly.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"source_month", "iso_weekday", "pickup_hour", "trip_count", "recorded_total_amount"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"source_month", type text}, {"iso_weekday", Int64.Type}, {"pickup_hour", Int64.Type}, {"trip_count", Int64.Type}, {"recorded_total_amount", type number}}, "en-US")
				in
				    Typed

