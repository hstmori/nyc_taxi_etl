/// ETL export: dq_missing.csv. Grain and caveats: docs/power-bi.md.
table Missing
	lineageTag: cee9d2a3-76f1-4cc2-af41-72f3ff1ae1e7

	/// Per-column count only; grand total across columns intentionally blank.
	measure 'Giá trị thiếu' = IF(ISINSCOPE(Missing[column_name]), SUM(Missing[missing_count]))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 7ccd2b92-2e32-4835-95ac-9a1bc091f51d

	/// Weighted by source rows within the selected months; no total across columns.
	measure 'Tỷ lệ thiếu' = IF(ISINSCOPE(Missing[column_name]), DIVIDE(SUM(Missing[missing_count]),SUM(Missing[raw_rows])))
		formatString: 0.00%
		displayFolder: Dashboard
		lineageTag: 7b7f8814-6d5e-4bdf-b049-964e95ea2335

	column source_month
		dataType: string
		lineageTag: a7b78a4e-d6be-438e-b20b-b4f087db9188
		summarizeBy: none
		sourceColumn: source_month

	column column_name
		dataType: string
		lineageTag: 409fca3d-4a59-45d3-bd5c-02cb9845badb
		summarizeBy: none
		sourceColumn: column_name

	column raw_rows
		dataType: int64
		isHidden
		lineageTag: ca704d18-f716-41d4-93aa-dea39791b25e
		summarizeBy: none
		sourceColumn: raw_rows

	column missing_count
		dataType: int64
		isHidden
		lineageTag: 12730e27-a9e2-43f1-9256-2c39e6aa3279
		summarizeBy: none
		sourceColumn: missing_count

	column missing_pct
		dataType: double
		isHidden
		lineageTag: b81a697f-7ea1-422f-87b2-eb8911e0fec2
		summarizeBy: none
		sourceColumn: missing_pct

	partition Missing = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "\dq_missing.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"source_month", "column_name", "raw_rows", "missing_count", "missing_pct"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"source_month", type text}, {"column_name", type text}, {"raw_rows", Int64.Type}, {"missing_count", Int64.Type}, {"missing_pct", type number}}, "en-US")
				in
				    Typed

